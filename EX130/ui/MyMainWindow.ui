  <property name="windowTitle">
   <string>DeprecX — Hệ Thống Tính Khấu Hao Tài Sản Cố Định</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* ================= GLOBAL WEB3 FOUNDATION ================= */
QMainWindow, QWidget#centralwidget {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1,
        stop:0 #080b11,
        stop:0.35 #0c1018,
        stop:0.7 #0e1320,
        stop:1 #080b12);
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    color: #f1f5f9;
}

/* ================= LEFT HERO &amp; STATS ================= */
QLabel#label {
    font-size: 32px;
    font-weight: 900;
    line-height: 1.15;
    background: transparent;
}

QLabel#heroDesc {
    color: #94a3b8;
    font-size: 13px;
    line-height: 1.5;
    background: transparent;
}

/* Stat Cards (Total Volume, Users, Chains equivalent) */
QFrame#statCard1, QFrame#statCard2, QFrame#statCard3 {
    background-color: #111722;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 10px 14px;
}

QFrame#statCard1:hover, QFrame#statCard2:hover, QFrame#statCard3:hover {
    border: 1px solid rgba(56, 189, 248, 0.3);
}

QLabel#nguyNGiTSCLabel, QLabel#mCTrChKhUHaoNMLabel, QLabel#mCTrChKhUHaoThNgLabel {
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: transparent;
}

QLineEdit#LineEditOrg {
    background: transparent;
    border: none;
    color: #34d399;
    font-size: 18px;
    font-weight: 900;
    padding: 2px 0;
}

QLineEdit#LineEditYearDep {
    background: transparent;
    border: none;
    color: #38bdf8;
    font-size: 18px;
    font-weight: 900;
    padding: 2px 0;
}

QLineEdit#LineEditMonthDep {
    background: transparent;
    border: none;
    color: #a78bfa;
    font-size: 18px;
    font-weight: 900;
    padding: 2px 0;
}

/* Schedule Card (List of annual depreciation) */
QFrame#scheduleCard {
    background-color: #111722;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 14px;
}

QLabel#scheduleTitle {
    color: #f1f5f9;
    font-size: 13px;
    font-weight: 700;
}

QLabel#scheduleSub {
    color: #64748b;
    font-size: 11px;
}

QPushButton#pushButtonDetail {
    background-color: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.35);
    color: #a5b4fc;
    border-radius: 10px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton#pushButtonDetail:hover {
    background-color: rgba(99, 102, 241, 0.3);
    border-color: #818cf8;
    color: #ffffff;
}

QPushButton#pushButtonDetail:pressed {
    background-color: #4f46e5;
}

QListWidget#listWidget {
    background-color: #0b0f17;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 6px;
    color: #e2e8f0;
    font-size: 12px;
}

QListWidget#listWidget::item {
    background-color: #131926;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: 8px 12px;
    margin-bottom: 4px;
    color: #f1f5f9;
}

QListWidget#listWidget::item:hover {
    background-color: rgba(56, 189, 248, 0.12);
    border-color: rgba(56, 189, 248, 0.3);
}

QListWidget#listWidget::item:selected {
    background: rgba(99, 102, 241, 0.25);
    border: 1px solid #6366f1;
    color: #ffffff;
    font-weight: 700;
}

/* ================= RIGHT SWAP CARD ================= */
QFrame#swapCard {
    background-color: #111722;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 24px;
    padding: 22px;
}

QLabel#swapTitle {
    color: #ffffff;
    font-size: 17px;
    font-weight: 800;
}

QLabel#swapStandardBadge {
    color: #64748b;
    font-size: 11px;
    font-weight: 600;
}

/* Swap Input Containers ("From" / "To" Style) */
QFrame#boxInputPrice, QFrame#boxInputCosts, QFrame#boxInputYear {
    background-color: #0b0f17;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
    padding: 12px 14px;
}

QFrame#boxInputPrice:hover, QFrame#boxInputCosts:hover, QFrame#boxInputYear:hover {
    border: 1px solid rgba(255, 255, 255, 0.15);
}

QLabel#giMuaMILabel, QLabel#phVNChuyNLabel, QLabel#phLPTLabel, QLabel#sNMSDNgDKiNLabel {
    color: #64748b;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QLabel#hintBalance, QLabel#hintRate, QLabel#hintSubCost {
    color: #64748b;
    font-size: 11px;
    background: transparent;
}

/* LineEdit Inputs inside Swap card */
QLineEdit#LineEditNew, QLineEdit#LineEditYear {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
    padding: 2px 0;
    selection-background-color: #5865F2;
}

QLineEdit#LineEditTrans, QLineEdit#LineEditSetup {
    background-color: #111722;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    color: #f1f5f9;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 10px;
    selection-background-color: #5865F2;
}

QLineEdit#LineEditTrans:focus, QLineEdit#LineEditSetup:focus {
    border: 1px solid #5865F2;
}

/* Token Badges (ETH / USDC equivalent) */
QLabel#tokenBadgeVND, QLabel#tokenBadgeYear, QLabel#tokenBadgeSub1, QLabel#tokenBadgeSub2 {
    background-color: #182030;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    padding: 5px 12px;
}

QLabel#tokenBadgeVND {
    color: #38bdf8;
}

QLabel#tokenBadgeYear {
    color: #a78bfa;
}

/* Bottom Rate/Formula Info */
QLabel#rateFormulaLabel {
    color: #64748b;
    font-size: 11px;
    background: transparent;
    padding: 4px 2px;
}

QLabel#rateFormulaValue {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}

/* Large Primary CTA Button (Like 'Connect Wallet') */
QPushButton#pushButtonCalc {
    background-color: #5865F2;
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    border-radius: 14px;
    padding: 13px 20px;
    border: none;
}

QPushButton#pushButtonCalc:hover {
    background-color: #4752c4;
}

QPushButton#pushButtonCalc:pressed {
    background-color: #3c45a5;
    padding-top: 14px;
}

/* Scrollbars */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.3);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QMenuBar, QStatusBar {
    background-color: transparent;
    color: #64748b;
    font-size: 11px;
}</string>
